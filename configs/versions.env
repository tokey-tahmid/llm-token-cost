# Pinned engine image (sourced by the job scripts). The -cu129 variant of
# v0.31.0 ships a torchcodec built for CUDA 13 that fails to load (OSError at
# import); the default image matches its own CUDA libraries.
VLLM_IMAGE=vllm/vllm-openai:v0.31.0
VLLM_SIF=vllm-openai_v0.31.0.sif
# SGLang robustness check (one configuration, brief 001): CUDA 13 runtime image, pinned by digest
SGLANG_IMAGE=lmsysorg/sglang:v0.5.21-runtime@sha256:df6ad77ad91b1f83985ebb789de97b83fc8745786abf5c2913d6d0387007e4cb
SGLANG_SIF=sglang_v0.5.21-runtime.sif
