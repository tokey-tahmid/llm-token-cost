# Copy to site.env (git-ignored) and adapt to your cluster.
# Slurm account/partition/QOS used by scripts/submit_*.sh
SLURM_ACCOUNT=myaccount
SLURM_PARTITION=gpu
SLURM_QOS=normal

# Shell run at the start of every job, e.g. module loads. Must make `apptainer`
# (and a Python >= 3.10 for the harness venv) available.
SITE_SETUP='module load Apptainer Python'

# Where container images (.sif) and the harness venv live (shared filesystem)
CONTAINER_DIR=/path/to/containers
VENV=/path/to/venv

# Node-local scratch for model weights and caches (tens to hundreds of GB)
SCRATCH=/dev/shm/$USER-bench

# Optional extra flags for `apptainer exec`
CONTAINER_EXTRA_ARGS=
